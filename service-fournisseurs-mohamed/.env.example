# =============================================================================
# ProcuraFlow — Service Fournisseurs (Mohamed)
# Example Environment Configuration (Safe Placeholders Only — NO REAL SECRETS)
# Copy this file to .env and fill in your local or Neon PostgreSQL credentials.
# =============================================================================

# Server HTTP port (Contract default: 8081)
SERVER_PORT=8081

# -----------------------------------------------------------------------------
# Neon PostgreSQL Connection
# Supported formats for DATABASE_URL:
#   1. Standard JDBC URL:
#      jdbc:postgresql://ep-example-123456.eu-central-1.aws.neon.tech:5432/procura_flow?sslmode=require&currentSchema=schema_fournisseurs
#   2. Neon URI / libpq connection string (automatically converted at startup):
#      postgresql://username:password@ep-example-123456.eu-central-1.aws.neon.tech/procura_flow?sslmode=require
# -----------------------------------------------------------------------------
DATABASE_URL=jdbc:postgresql://<neon-endpoint-host>:5432/procura_flow?sslmode=require&currentSchema=schema_fournisseurs
DATABASE_USERNAME=<neon-username>
DATABASE_PASSWORD=<neon-password>

# Database schema owned by Fournisseurs service
DATABASE_SCHEMA=schema_fournisseurs

# Hibernate DDL strategy (Keep 'validate' for shared Neon database)
JPA_DDL_AUTO=validate

# -----------------------------------------------------------------------------
# Downstream Microservice Integration (Yassine — Commandes Service)
# Local host development: http://localhost:8082
# Docker Compose network: http://service-commandes:8082
# -----------------------------------------------------------------------------
COMMANDES_SERVICE_URL=http://localhost:8082
COMMANDES_CONNECT_TIMEOUT_MS=3000
COMMANDES_READ_TIMEOUT_MS=5000
