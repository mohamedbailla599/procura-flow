# =============================================================================
# ProcuraFlow — Root Docker Compose Environment Example (Safe Placeholders Only)
# Copy to .env (uncommitted) to configure Neon PostgreSQL credentials.
# =============================================================================

# Hosted Neon PostgreSQL 17 connection (Database: procura_flow, Branch: main)
DATABASE_URL=jdbc:postgresql://<neon-endpoint-host>:5432/procura_flow?sslmode=require&currentSchema=schema_fournisseurs
DATABASE_USERNAME=<neon-username>
DATABASE_PASSWORD=<neon-password>

# Service Fournisseurs (Mohamed)
SERVER_PORT=8081
COMMANDES_SERVICE_URL=http://service-commandes:8082
